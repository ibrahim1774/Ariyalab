# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Core app
# ---------------------------------------------------------------------------

# Public base URL of the app (Stripe return URLs). Optional: derived from the request when unset.
APP_URL=
# Comma-separated admin emails (server-side checks).
ADMIN_EMAILS=
# Same list exposed to the browser for admin-only UI.
NEXT_PUBLIC_ADMIN_EMAILS=
# Shared secret that scheduled jobs (cron) send to the app.
CRON_SECRET=
# Set to 1 to make every AI provider return local fixtures with no network (tests always do).
STORY_MOCK=

# ---------------------------------------------------------------------------
# Supabase (auth, profiles, story tables)
# ---------------------------------------------------------------------------

# Project URL from Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
# Anon (public) key from the same page.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key, server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Legacy fallbacks inherited from a sibling project; used only when the NEXT_PUBLIC_* names are unset.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------

# OAuth client id for Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Legacy fallback for the same value.
VITE_GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# Stripe secret key (sk_test_... locally).
STRIPE_SECRET_KEY=
# Signing secret of the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Marketing and analytics
# ---------------------------------------------------------------------------

# Meta Conversions API access token (pixel id is in components/MetaPixel.js and lib/meta.js).
META_ACCESS_TOKEN=
# Meta Marketing API token and ad account id for the ads tools.
META_ADS_TOKEN=
META_ADS_ACCOUNT_ID=
# TikTok pixel id.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Amazon affiliate tag used in product links.
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG=
# Social profile links shown in the footer.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
# Number shown in the homepage "videos this week" counter.
NEXT_PUBLIC_VIDEOS_THIS_WEEK=

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------

# Anthropic API key (Claude: moderation, analysis, script, chat).
ANTHROPIC_API_KEY=
# kie.ai key (Kling 3.0 and Seedance video, Nano Banana images). https://kie.ai/api-key
KIE_API_KEY=
# Secret added to the kie.ai callBackUrl so callbacks can be verified.
KIE_WEBHOOK_SECRET=
# Replicate token (legacy tools; also the fallback transcriber). https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Recommended: Groq key, the default transcriber (Whisper with word timestamps).
GROQ_API_KEY=
# Apify token, the default reference-video downloader (Instagram, TikTok, Facebook).
APIFY_TOKEN=
# Optional: ScrapeCreators key, used for reference downloads only when APIFY_TOKEN is unset.
SCRAPECREATORS_API_KEY=
# Fish Audio key (narration and voice cloning).
FISH_API_KEY=
# Google AI Studio (Gemini API) key for Lyria music.
GOOGLE_AI_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Vercel Blob read-write token (default storage; auto-added with a Blob store; locally: vercel env pull).
BLOB_READ_WRITE_TOKEN=
# Optional: Cloudflare R2. Used instead of Blob only when ALL five R2_* values are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the R2 bucket (custom domain or r2.dev URL), no trailing slash needed.
R2_PUBLIC_URL=

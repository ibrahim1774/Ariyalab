{
  "crons": [
    {
      "path": "/api/cron/cleanup-history",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/story-tick",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/oauth-cleanup",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/legacy-holds",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/grant-yearly",
      "schedule": "15 4 * * *"
    }
  ],
  "functions": {
    "pages/api/story/render-worker.js": {
      "memory": 3009,
      "maxDuration": 300
    }
  }
}
